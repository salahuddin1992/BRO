# Helen WiFi - Environment Variables (all optional, sensible defaults exist)

# Server
BRO_PORT=8400
BRO_SECRET=                    # Auto-generated and persisted if empty
BRO_RUNTIME_PATH=              # Override writable path for DB/uploads/logs

# Admin
BRO_ADMIN_USER=admin
BRO_ADMIN_PASS=admin123

# TLS (auto-generated self-signed if not provided)
BRO_TLS_CERT=
BRO_TLS_KEY=

# Services (1=enabled, 0=disabled)
BRO_SSH_ENABLED=1
BRO_SSH_PORT=2222
BRO_FTP_ENABLED=1
BRO_FTP_PORT=2121
BRO_SFTP_ENABLED=1
BRO_SFTP_PORT=2223

# Files
BRO_FILE_KEY=                  # Defaults to SECRET_KEY[:32]
BRO_FILE_TTL=0                 # Days until file expiry (0=never)

# Logging
BRO_LOG_LEVEL=INFO
